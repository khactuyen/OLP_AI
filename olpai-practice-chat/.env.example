# Chỉ điền key vào .env trên máy bạn. Không gửi key vào chat.
OLP_BACKEND=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Chỉ dùng các mục dưới nếu chủ động đổi OLP_BACKEND=openrouter.
OPENROUTER_API_KEY=
# Provider slug (tùy chọn). Khi đã chọn, ứng dụng không đổi provider.
OPENROUTER_PROVIDER=
# 2048 là cấu hình luyện tập theo yêu cầu, không lấy từ PDF.
OLP_CONTEXT_LIMIT=2048
OLP_OUTPUT_TARGET=768
OLP_TOKEN_MARGIN=64
OLP_TEMPERATURE=0.6
# Chỉ bật để xem giao diện bằng câu trả lời giả, không gọi model.
OLP_DEMO=0
